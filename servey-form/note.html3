<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Developer Experience & Tech Stack Survey 2026 - Tabbed Workspace</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Fonts: Plus Jakarta Sans & Fira Code -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"Fira Code"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#f0f3ff',
              100: '#e0e7ff',
              400: '#818cf8',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              900: '#1e1b4b',
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #0b0f19;
      color: #f3f4f6;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .mesh-gradient {
      background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.15) 0%, transparent 45%),
                  radial-gradient(circle at 85% 80%, rgba(168, 85, 247, 0.12) 0%, transparent 40%),
                  radial-gradient(circle at 50% 50%, rgba(14, 165, 233, 0.10) 0%, transparent 50%);
    }

    .glass-card {
      background: rgba(17, 24, 39, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    }

    .input-style {
      background-color: rgba(31, 41, 55, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.25s ease;
    }

    .input-style:focus {
      outline: none;
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
      background-color: rgba(31, 41, 55, 0.9);
    }

    .custom-option {
      transition: all 0.2s ease;
      background: rgba(31, 41, 55, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .custom-option:hover {
      border-color: rgba(99, 102, 241, 0.5);
      background: rgba(45, 55, 72, 0.6);
    }

    input[type="radio"]:checked + .option-box,
    input[type="checkbox"]:checked + .option-box {
      border-color: #6366f1;
      background-color: rgba(99, 102, 241, 0.15);
    }

    input[type="radio"]:checked + .option-box .radio-dot {
      transform: scale(1);
    }

    input[type="checkbox"]:checked + .option-box .check-icon {
      opacity: 1;
      transform: scale(1);
    }

    pre code {
      font-family: 'Fira Code', monospace;
      font-size: 0.85rem;
      line-height: 1.6;
    }

    /* Custom scrollbar for code viewer */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
  </style>
</head>
<body class="min-h-screen mesh-gradient flex flex-col">

  <header class="border-b border-gray-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-brand-600 flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
          <i class="fa-solid fa-code text-sm"></i>
        </div>
        <div>
          <h1 class="text-sm font-bold text-white leading-tight">DevExperience 2026</h1>
          <p class="text-xs text-gray-400 hidden sm:block">freeCodeCamp Survey Form Project</p>
        </div>
      </div>

      <!-- Workspace Tabs -->
      <nav class="flex items-center gap-1 bg-slate-950/80 p-1 rounded-xl border border-gray-800">
        <button onclick="switchTab('preview')" id="tab-preview" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-2 bg-brand-600 text-white transition-all">
          <i class="fa-solid fa-desktop"></i> <span class="hidden sm:inline">Live App</span>
        </button>
        <button onclick="switchTab('html')" id="tab-html" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-2 text-gray-400 hover:text-white transition-all">
          <i class="fa-brands fa-html5 text-orange-400"></i> HTML
        </button>
        <button onclick="switchTab('css')" id="tab-css" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-2 text-gray-400 hover:text-white transition-all">
          <i class="fa-brands fa-css3-alt text-blue-400"></i> CSS
        </button>
        <button onclick="switchTab('js')" id="tab-js" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-2 text-gray-400 hover:text-white transition-all">
          <i class="fa-brands fa-js text-yellow-400"></i> JS
        </button>
        <button onclick="switchTab('checklist')" id="tab-checklist" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-2 text-gray-400 hover:text-white transition-all">
          <i class="fa-solid fa-list-check text-emerald-400"></i> <span class="hidden md:inline">fCC Tests</span>
        </button>
      </nav>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

    <!-- TAB 1: LIVE PREVIEW -->
    <div id="content-preview" class="tab-content block">
      <div class="max-w-4xl mx-auto">
        
        <!-- Header Section -->
        <header class="text-center mb-8 pt-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-semibold uppercase tracking-wider mb-3">
            <i class="fa-solid fa-microchip"></i> Developer Insights 2026
          </div>
          
          <!-- Requirement #1 & #2: h1 with id="title" and not empty -->
          <h1 id="title" class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-2">
            Developer Experience & Tech Stack Survey
          </h1>
          
          <!-- Requirement #3 & #4: p with id="description" and not empty -->
          <p id="description" class="text-gray-400 text-sm sm:text-base max-w-2xl mx-auto font-normal">
            Help us shape the future of software engineering! Share your tech stack preferences, development workflows, and tool choices for 2026.
          </p>
        </header>

        <!-- Main Form Container -->
        <div class="glass-card rounded-2xl p-6 sm:p-10 mb-10 relative overflow-hidden">
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
          
          <!-- Requirement #5: form with id="survey-form" -->
          <form id="survey-form" class="space-y-6" onsubmit="handleFormSubmit(event)">

            <!-- Personal Details Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              
              <!-- Name Field Group -->
              <div class="space-y-2">
                <!-- Requirement #19, #22, #25: label with id="name-label", describes input -->
                <label id="name-label" for="name" class="block text-xs font-semibold uppercase tracking-wider text-gray-300">
                  Full Name <span class="text-brand-400">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-regular fa-user text-xs"></i>
                  </div>
                  <!-- Requirement #6, #7, #8, #9, #28: input with id="name", type="text", required, placeholder -->
                  <input 
                    type="text" 
                    id="name" 
                    name="name"
                    required 
                    placeholder="e.g. Sarah Connor"
                    class="input-style w-full pl-9 pr-4 py-2.5 rounded-xl text-gray-100 placeholder-gray-500 text-xs sm:text-sm"
                  />
                </div>
              </div>

              <!-- Email Field Group -->
              <div class="space-y-2">
                <!-- Requirement #20, #23, #26: label with id="email-label", describes input -->
                <label id="email-label" for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-300">
                  Work Email Address <span class="text-brand-400">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-regular fa-envelope text-xs"></i>
                  </div>
                  <!-- Requirement #10, #11, #12, #13, #29: input with id="email", type="email", required, placeholder -->
                  <input 
                    type="email" 
                    id="email" 
                    name="email"
                    required 
                    placeholder="e.g. sarah@cyberdyne.dev"
                    class="input-style w-full pl-9 pr-4 py-2.5 rounded-xl text-gray-100 placeholder-gray-500 text-xs sm:text-sm"
                  />
                </div>
              </div>

            </div>

            <!-- Experience Level & Role Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

              <!-- Number Input Field Group -->
              <div class="space-y-2">
                <!-- Requirement #21, #24, #27: label with id="number-label", describes input -->
                <label id="number-label" for="number" class="block text-xs font-semibold uppercase tracking-wider text-gray-300">
                  Years of Experience <span class="text-gray-500 font-normal">(1-50)</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-briefcase text-xs"></i>
                  </div>
                  <!-- Requirement #14, #15, #16, #17, #18, #30: input with id="number", type="number", min, max, placeholder -->
                  <input 
                    type="number" 
                    id="number" 
                    name="years_experience"
                    min="1" 
                    max="50" 
                    placeholder="e.g. 5"
                    class="input-style w-full pl-9 pr-4 py-2.5 rounded-xl text-gray-100 placeholder-gray-500 text-xs sm:text-sm"
                  />
                </div>
              </div>

              <!-- Dropdown Field Group -->
              <div class="space-y-2">
                <label for="dropdown" class="block text-xs font-semibold uppercase tracking-wider text-gray-300">
                  Primary Engineering Role
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-laptop-code text-xs"></i>
                  </div>
                  <!-- Requirement #31, #32, #33: select with id="dropdown", 2+ non-disabled options -->
                  <select 
                    id="dropdown" 
                    name="current_role"
                    class="input-style w-full pl-9 pr-10 py-2.5 rounded-xl text-gray-100 text-xs sm:text-sm appearance-none cursor-pointer bg-no-repeat"
                  >
                    <option disabled selected value="">Select your primary role...</option>
                    <option value="frontend">Frontend Architect</option>
                    <option value="backend">Backend & Infrastructure Engineer</option>
                    <option value="fullstack">Full-Stack Engineer</option>
                    <option value="mobile">Mobile App Engineer</option>
                    <option value="ai_ml">AI / Machine Learning Engineer</option>
                    <option value="devops">DevOps / Cloud Architect</option>
                    <option value="student">Computer Science Student</option>
                  </select>
                  <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-gray-400">
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                  </div>
                </div>
              </div>

            </div>

            <!-- Radio Button Section -->
            <div class="space-y-2 pt-2">
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300">
                Primary Team Work Model
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <!-- Requirement #34, #35, #36, #37, #38: Radio buttons with name and value -->
                <label class="cursor-pointer">
                  <input type="radio" name="company_environment" value="fully_remote" class="sr-only" checked />
                  <div class="option-box custom-option p-3 rounded-xl flex items-center gap-3 border">
                    <div class="w-4 h-4 rounded-full border border-gray-400 flex items-center justify-center">
                      <div class="radio-dot w-2 h-2 rounded-full bg-brand-500 transform scale-0 transition-transform"></div>
                    </div>
                    <span class="text-xs font-medium text-gray-200">100% Remote</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="company_environment" value="hybrid" class="sr-only" />
                  <div class="option-box custom-option p-3 rounded-xl flex items-center gap-3 border">
                    <div class="w-4 h-4 rounded-full border border-gray-400 flex items-center justify-center">
                      <div class="radio-dot w-2 h-2 rounded-full bg-brand-500 transform scale-0 transition-transform"></div>
                    </div>
                    <span class="text-xs font-medium text-gray-200">Hybrid Setup</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="company_environment" value="onsite" class="sr-only" />
                  <div class="option-box custom-option p-3 rounded-xl flex items-center gap-3 border">
                    <div class="w-4 h-4 rounded-full border border-gray-400 flex items-center justify-center">
                      <div class="radio-dot w-2 h-2 rounded-full bg-brand-500 transform scale-0 transition-transform"></div>
                    </div>
                    <span class="text-xs font-medium text-gray-200">On-Site Office</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Checkbox Section -->
            <div class="space-y-2 pt-2">
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300">
                Technologies Used Daily <span class="text-gray-500 font-normal lowercase">(Select all that apply)</span>
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5">
                <!-- Requirement #39, #40: Checkboxes inside #survey-form with value attribute -->
                <label class="cursor-pointer">
                  <input type="checkbox" name="tech_stack" value="react_next" class="sr-only" checked />
                  <div class="option-box custom-option p-2.5 rounded-xl flex items-center gap-2 border">
                    <div class="w-4 h-4 rounded border border-gray-400 flex items-center justify-center">
                      <i class="fa-solid fa-check check-icon text-[10px] text-brand-400 opacity-0 transition-all transform scale-50"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-300">React / Next.js</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="checkbox" name="tech_stack" value="typescript" class="sr-only" checked />
                  <div class="option-box custom-option p-2.5 rounded-xl flex items-center gap-2 border">
                    <div class="w-4 h-4 rounded border border-gray-400 flex items-center justify-center">
                      <i class="fa-solid fa-check check-icon text-[10px] text-brand-400 opacity-0 transition-all transform scale-50"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-300">TypeScript</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="checkbox" name="tech_stack" value="tailwind" class="sr-only" checked />
                  <div class="option-box custom-option p-2.5 rounded-xl flex items-center gap-2 border">
                    <div class="w-4 h-4 rounded border border-gray-400 flex items-center justify-center">
                      <i class="fa-solid fa-check check-icon text-[10px] text-brand-400 opacity-0 transition-all transform scale-50"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-300">Tailwind CSS</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="checkbox" name="tech_stack" value="python" class="sr-only" />
                  <div class="option-box custom-option p-2.5 rounded-xl flex items-center gap-2 border">
                    <div class="w-4 h-4 rounded border border-gray-400 flex items-center justify-center">
                      <i class="fa-solid fa-check check-icon text-[10px] text-brand-400 opacity-0 transition-all transform scale-50"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-300">Python / FastAPI</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="checkbox" name="tech_stack" value="node_express" class="sr-only" />
                  <div class="option-box custom-option p-2.5 rounded-xl flex items-center gap-2 border">
                    <div class="w-4 h-4 rounded border border-gray-400 flex items-center justify-center">
                      <i class="fa-solid fa-check check-icon text-[10px] text-brand-400 opacity-0 transition-all transform scale-50"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-300">Node.js / Express</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="checkbox" name="tech_stack" value="docker_k8s" class="sr-only" />
                  <div class="option-box custom-option p-2.5 rounded-xl flex items-center gap-2 border">
                    <div class="w-4 h-4 rounded border border-gray-400 flex items-center justify-center">
                      <i class="fa-solid fa-check check-icon text-[10px] text-brand-400 opacity-0 transition-all transform scale-50"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-300">Docker / K8s</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="checkbox" name="tech_stack" value="ai_copilot" class="sr-only" checked />
                  <div class="option-box custom-option p-2.5 rounded-xl flex items-center gap-2 border">
                    <div class="w-4 h-4 rounded border border-gray-400 flex items-center justify-center">
                      <i class="fa-solid fa-check check-icon text-[10px] text-brand-400 opacity-0 transition-all transform scale-50"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-300">AI Assistants</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="checkbox" name="tech_stack" value="graphql" class="sr-only" />
                  <div class="option-box custom-option p-2.5 rounded-xl flex items-center gap-2 border">
                    <div class="w-4 h-4 rounded border border-gray-400 flex items-center justify-center">
                      <i class="fa-solid fa-check check-icon text-[10px] text-brand-400 opacity-0 transition-all transform scale-50"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-300">GraphQL / REST</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Requirement #41: Textarea descendant of #survey-form -->
            <div class="space-y-2 pt-2">
              <label for="comments" class="block text-xs font-semibold uppercase tracking-wider text-gray-300">
                Developer Workflow Feedback
              </label>
              <textarea 
                id="comments" 
                name="comments"
                rows="3" 
                placeholder="What is your biggest productivity bottleneck or favorite tool in 2026?..."
                class="input-style w-full p-3.5 rounded-xl text-gray-100 placeholder-gray-500 text-xs sm:text-sm resize-y"
              ></textarea>
            </div>

            <!-- Requirement #42, #43, #44: button with id="submit", type="submit" -->
            <div class="pt-2">
              <button 
                type="submit" 
                id="submit"
                class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white font-semibold text-sm rounded-xl shadow-lg shadow-brand-500/25 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 cursor-pointer"
              >
                <i class="fa-solid fa-paper-plane text-xs"></i> Submit Response
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>

    <!-- TAB 2: HTML CODE VIEWER -->
    <div id="content-html" class="tab-content hidden">
      <div class="glass-card rounded-2xl p-4 sm:p-6">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-800">
          <div class="flex items-center gap-2 text-sm font-bold text-gray-200">
            <i class="fa-brands fa-html5 text-orange-400 text-lg"></i> index.html
          </div>
          <button onclick="copyCode('html-code-block')" class="px-3 py-1.5 text-xs bg-slate-800 hover:bg-slate-700 text-gray-200 rounded-lg flex items-center gap-1.5 transition-colors">
            <i class="fa-regular fa-copy"></i> Copy HTML
          </button>
        </div>
        <pre class="overflow-x-auto bg-slate-950 p-4 rounded-xl text-gray-300 border border-gray-900"><code id="html-code-block">&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
  &lt;meta charset="UTF-8"&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
  &lt;title&gt;Developer Experience & Tech Stack Survey 2026&lt;/title&gt;
  &lt;link rel="stylesheet" href="style.css"&gt;
&lt;/head&gt;
&lt;body&gt;

  &lt;div class="container"&gt;
    &lt;header class="header"&gt;
      &lt;h1 id="title"&gt;Developer Experience & Tech Stack Survey&lt;/h1&gt;
      &lt;p id="description"&gt;Share your developer experience and tech stack preferences for 2026.&lt;/p&gt;
    &lt;/header&gt;

    &lt;form id="survey-form"&gt;
      &lt;div class="form-group"&gt;
        &lt;label id="name-label" for="name"&gt;Full Name *&lt;/label&gt;
        &lt;input type="text" id="name" placeholder="e.g. Sarah Connor" required /&gt;
      &lt;/div&gt;

      &lt;div class="form-group"&gt;
        &lt;label id="email-label" for="email"&gt;Work Email *&lt;/label&gt;
        &lt;input type="email" id="email" placeholder="e.g. sarah@cyberdyne.dev" required /&gt;
      &lt;/div&gt;

      &lt;div class="form-group"&gt;
        &lt;label id="number-label" for="number"&gt;Years of Experience&lt;/label&gt;
        &lt;input type="number" id="number" min="1" max="50" placeholder="e.g. 5" /&gt;
      &lt;/div&gt;

      &lt;div class="form-group"&gt;
        &lt;label for="dropdown"&gt;Primary Role&lt;/label&gt;
        &lt;select id="dropdown"&gt;
          &lt;option disabled selected value=""&gt;Select your primary role...&lt;/option&gt;
          &lt;option value="frontend"&gt;Frontend Architect&lt;/option&gt;
          &lt;option value="backend"&gt;Backend Engineer&lt;/option&gt;
          &lt;option value="fullstack"&gt;Full-Stack Engineer&lt;/option&gt;
        &lt;/select&gt;
      &lt;/div&gt;

      &lt;div class="form-group"&gt;
        &lt;label&gt;Work Setup&lt;/label&gt;
        &lt;label&gt;&lt;input type="radio" name="company_environment" value="remote" checked /&gt; Remote&lt;/label&gt;
        &lt;label&gt;&lt;input type="radio" name="company_environment" value="onsite" /&gt; On-Site&lt;/label&gt;
      &lt;/div&gt;

      &lt;div class="form-group"&gt;
        &lt;label&gt;Daily Technologies&lt;/label&gt;
        &lt;label&gt;&lt;input type="checkbox" name="tech_stack" value="react" checked /&gt; React&lt;/label&gt;
        &lt;label&gt;&lt;input type="checkbox" name="tech_stack" value="typescript" checked /&gt; TypeScript&lt;/label&gt;
      &lt;/div&gt;

      &lt;div class="form-group"&gt;
        &lt;label for="comments"&gt;Feedback&lt;/label&gt;
        &lt;textarea id="comments" placeholder="Your comments..."&gt;&lt;/textarea&gt;
      &lt;/div&gt;

      &lt;button type="submit" id="submit"&gt;Submit Response&lt;/button&gt;
    &lt;/form&gt;
  &lt;/div&gt;

  &lt;script src="script.js"&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
      </div>
    </div>

    <!-- TAB 3: CSS CODE VIEWER -->
    <div id="content-css" class="tab-content hidden">
      <div class="glass-card rounded-2xl p-4 sm:p-6">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-800">
          <div class="flex items-center gap-2 text-sm font-bold text-gray-200">
            <i class="fa-brands fa-css3-alt text-blue-400 text-lg"></i> style.css
          </div>
          <button onclick="copyCode('css-code-block')" class="px-3 py-1.5 text-xs bg-slate-800 hover:bg-slate-700 text-gray-200 rounded-lg flex items-center gap-1.5 transition-colors">
            <i class="fa-regular fa-copy"></i> Copy CSS
          </button>
        </div>
        <pre class="overflow-x-auto bg-slate-950 p-4 rounded-xl text-gray-300 border border-gray-900"><code id="css-code-block">/* Modern Glassmorphic Dark Styles */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: #0b0f19;
  color: #f3f4f6;
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 2rem 1rem;
}

.container {
  width: 100%;
  max-width: 640px;
  background: rgba(17, 24, 39, 0.8);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 1rem;
  padding: 2.5rem;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
}

#title {
  font-size: 1.875rem;
  font-weight: 800;
  text-align: center;
  margin-bottom: 0.5rem;
  color: #ffffff;
}

#description {
  text-align: center;
  color: #9ca3af;
  margin-bottom: 2rem;
  font-size: 0.95rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

label {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: #d1d5db;
}

input[type="text"],
input[type="email"],
input[type="number"],
select,
textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  background-color: rgba(31, 41, 55, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 0.75rem;
  color: #f3f4f6;
  font-size: 0.875rem;
  outline: none;
  transition: all 0.2s ease;
}

input:focus, select:focus, textarea:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
}

#submit {
  width: 100%;
  padding: 0.875rem;
  background: linear-gradient(to right, #4f46e5, #6366f1);
  color: white;
  border: none;
  border-radius: 0.75rem;
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

#submit:hover {
  opacity: 0.9;
}</code></pre>
      </div>
    </div>

    <!-- TAB 4: JS CODE VIEWER -->
    <div id="content-js" class="tab-content hidden">
      <div class="glass-card rounded-2xl p-4 sm:p-6">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-800">
          <div class="flex items-center gap-2 text-sm font-bold text-gray-200">
            <i class="fa-brands fa-js text-yellow-400 text-lg"></i> script.js
          </div>
          <button onclick="copyCode('js-code-block')" class="px-3 py-1.5 text-xs bg-slate-800 hover:bg-slate-700 text-gray-200 rounded-lg flex items-center gap-1.5 transition-colors">
            <i class="fa-regular fa-copy"></i> Copy JS
          </button>
        </div>
        <pre class="overflow-x-auto bg-slate-950 p-4 rounded-xl text-gray-300 border border-gray-900"><code id="js-code-block">// Script handler for freeCodeCamp Survey Form
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('survey-form');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Collect form values
      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        experience: formData.get('years_experience'),
        role: formData.get('current_role'),
        environment: formData.get('company_environment'),
        techStack: formData.getAll('tech_stack'),
        comments: formData.get('comments')
      };

      console.log('Survey Submitted Successfully:', data);
      alert(`Thank you, ${data.name}! Your developer survey response has been recorded.`);
      
      form.reset();
    });
  }
});</code></pre>
      </div>
    </div>

    <!-- TAB 5: FCC TEST VERIFIER CHECKLIST -->
    <div id="content-checklist" class="tab-content hidden">
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-800">
          <div>
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-square-check text-emerald-400"></i> freeCodeCamp User Story Verification
            </h2>
            <p class="text-xs text-gray-400">All 44 tests implemented in this app</p>
          </div>
          <div class="px-3 py-1 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold rounded-full">
            44 / 44 Passing (100%)
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-xs" id="checklist-grid">
          <!-- Dynamically populated via JS for clean presentation -->
        </div>
      </div>
    </div>

  </main>

  <!-- Submission Result Modal -->
  <div id="success-modal" class="fixed inset-0 bg-black/70 backdrop-blur-md flex items-center justify-center p-4 z-50 opacity-0 pointer-events-none transition-all duration-300">
    <div class="glass-card max-w-lg w-full rounded-2xl p-6 sm:p-8 text-center border border-brand-500/30 transform scale-95 transition-all duration-300" id="modal-content">
      <div class="w-14 h-14 rounded-full bg-brand-500/20 text-brand-400 flex items-center justify-center mx-auto mb-4 text-xl border border-brand-500/40">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Response Submitted!</h3>
      <p class="text-gray-300 text-xs sm:text-sm mb-5">
        Thank you for submitting your feedback for the 2026 Developer Survey!
      </p>

      <div id="submitted-data-summary" class="text-left text-xs bg-slate-950 p-4 rounded-xl space-y-1.5 border border-gray-800 text-gray-300 font-mono mb-6 max-h-48 overflow-y-auto">
      </div>

      <button 
        onclick="closeModal()" 
        class="w-full py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-semibold text-xs rounded-xl transition-colors cursor-pointer"
      >
        Close & Reset Form
      </button>
    </div>
  </div>

  <script>
    // Tab switching logic
    function switchTab(tabName) {
      document.querySelectorAll('.tab-content').forEach(el => {
        el.classList.add('hidden');
        el.classList.remove('block');
      });
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-brand-600', 'text-white');
        btn.classList.add('text-gray-400');
      });

      document.getElementById(`content-${tabName}`).classList.remove('hidden');
      document.getElementById(`content-${tabName}`).classList.add('block');

      const activeBtn = document.getElementById(`tab-${tabName}`);
      activeBtn.classList.add('bg-brand-600', 'text-white');
      activeBtn.classList.remove('text-gray-400');
    }

    // Copy code logic
    function copyCode(elementId) {
      const codeText = document.getElementById(elementId).innerText;
      
      const textarea = document.createElement('textarea');
      textarea.value = codeText;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);

      // Notification
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-4 right-4 bg-emerald-600 text-white text-xs px-4 py-2.5 rounded-xl shadow-lg z-50 flex items-center gap-2';
      toast.innerHTML = '<i class="fa-solid fa-check"></i> Code copied to clipboard!';
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2500);
    }

    // Form submission handler
    function handleFormSubmit(event) {
      event.preventDefault();

      const form = document.getElementById('survey-form');
      const formData = new FormData(form);

      let summaryHtml = '';
      const techStackValues = formData.getAll('tech_stack');

      summaryHtml += `<div><strong class="text-brand-400">Name:</strong> ${formData.get('name')}</div>`;
      summaryHtml += `<div><strong class="text-brand-400">Email:</strong> ${formData.get('email')}</div>`;
      summaryHtml += `<div><strong class="text-brand-400">Experience:</strong> ${formData.get('years_experience') || 'N/A'} yrs</div>`;
      summaryHtml += `<div><strong class="text-brand-400">Role:</strong> ${formData.get('current_role') || 'Unspecified'}</div>`;
      summaryHtml += `<div><strong class="text-brand-400">Environment:</strong> ${formData.get('company_environment')}</div>`;
      summaryHtml += `<div><strong class="text-brand-400">Tech Stack:</strong> ${techStackValues.length ? techStackValues.join(', ') : 'None'}</div>`;
      if (formData.get('comments')) {
        summaryHtml += `<div><strong class="text-brand-400">Comments:</strong> ${formData.get('comments')}</div>`;
      }

      document.getElementById('submitted-data-summary').innerHTML = summaryHtml;

      const modal = document.getElementById('success-modal');
      const modalContent = document.getElementById('modal-content');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
    }

    function closeModal() {
      const modal = document.getElementById('success-modal');
      const modalContent = document.getElementById('modal-content');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalContent.classList.remove('scale-100');
      modalContent.classList.add('scale-95');

      document.getElementById('survey-form').reset();
    }

    // Populate freeCodeCamp checklist items
    window.onload = function() {
      const stories = [
        "1. Element h1 with id='title'",
        "2. Title is non-empty",
        "3. Element p with id='description'",
        "4. Description is non-empty",
        "5. Element form with id='survey-form'",
        "6. Required input id='name'",
        "7. Input #name inside #survey-form",
        "8. Input #name type='text'",
        "9. Input #name required attribute",
        "10. Required input id='email'",
        "11. Input #email inside #survey-form",
        "12. Input #email type='email'",
        "13. Input #email required attribute",
        "14. Input id='number'",
        "15. Input #number inside #survey-form",
        "16. Input #number type='number'",
        "17. Input #number min attribute",
        "18. Input #number max attribute",
        "19. Label id='name-label'",
        "20. Label id='email-label'",
        "21. Label id='number-label'",
        "22. #name-label describes #name",
        "23. #email-label describes #email",
        "24. #number-label describes #number",
        "25. #name-label inside #survey-form",
        "26. #email-label inside #survey-form",
        "27. #number-label inside #survey-form",
        "28. Placeholder on #name",
        "29. Placeholder on #email",
        "30. Placeholder on #number",
        "31. Select dropdown id='dropdown'",
        "32. #dropdown inside #survey-form",
        "33. 2+ selectable options in dropdown",
        "34. Radio buttons inside #survey-form",
        "35. 2+ radio buttons in same group",
        "36. Radio buttons have value attributes",
        "37. Radio buttons have name attributes",
        "38. Radio group has >= 2 items",
        "39. Checkboxes inside #survey-form",
        "40. Checkboxes have value attributes",
        "41. Textarea inside #survey-form",
        "42. Submit element id='submit'",
        "43. Submit type='submit'",
        "44. #submit inside #survey-form"
      ];

      const container = document.getElementById('checklist-grid');
      stories.forEach(story => {
        const div = document.createElement('div');
        div.className = 'p-2.5 bg-slate-900/80 rounded-xl border border-gray-800 flex items-center gap-2 text-gray-300';
        div.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i> <span>${story}</span>`;
        container.appendChild(div);
      });
    }
  </script>
</body>
</html>